{
    "name": "folder-bridge-local",
    "version": "0.1.2",
    "description": "Windows-focused fork of Folder Bridge: mount local folders, mapped drives and UNC shares into an Obsidian vault.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint main.ts \"src/**/*.ts\"",
        "test": "vitest run",
        "validate": "npm run lint && npm run build && npm test",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "windows",
        "network-drive",
        "folder-bridge"
    ],
    "author": "grub-basket",
    "license": "MIT",
    "devDependencies": {
        "@eslint/json": "^1.1.0",
        "@types/node": "^20.11.16",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "0.28.2",
        "eslint": "^10.2.0",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "globals": "^17.13.0",
        "obsidian": "^1.13.1",
        "tslib": "2.6.2",
        "typescript": "5.3.3",
        "typescript-eslint": "^8.56.0",
        "vitest": "^4.1.11"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/grub-basket/Folder-Bridge-Local.git"
    },
    "dependencies": {
        "node-diff3": "3.2.1"
    }
}
